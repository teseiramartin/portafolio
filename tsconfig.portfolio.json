{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "app/page.tsx",
    "app/project-gallery.tsx",
    "app/components",
    "app/hooks",
    "app/i18n",
    "app/data",
    "app/services"
  ]
}
