  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "install:ci": "npm install",
    "dev": "vite --host 0.0.0.0",
    "yarn:dev": "vite --host 0.0.0.0",
    "build": "vite build",
